<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext forbidden; production pins to AnaOS hosts (TASK_066). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">releases.anaos.org</domain>
        <domain includeSubdomains="true">dl.anaos.org</domain>
    </domain-config>
</network-security-config>
