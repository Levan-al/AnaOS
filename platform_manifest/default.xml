<?xml version="1.0" encoding="UTF-8"?>
<!--
  AnaOS platform manifest (TASK_010 / TASK_011 / TASK_012)
  Remotes point at Levan-al forks until AnaOS GitHub org exists.
  Full AOSP include is added when a release branch is pinned on a capable build host.
-->
<manifest>
  <remote name="aosp"
          fetch="https://android.googlesource.com"
          review="https://android-review.googlesource.com/" />

  <remote name="anaos"
          fetch="https://github.com/Levan-al"
          review="https://github.com/Levan-al" />

  <default revision="main"
           remote="anaos"
           sync-j="4" />

  <!-- AnaOS meta / tooling -->
  <project path="branding" name="branding" remote="anaos" />
  <project path="script" name="script" remote="anaos" />
  <project path="external/hardened_malloc" name="grapheneos_hardened_malloc" remote="anaos" />
  <project path="vendor/adevtool" name="grapheneos_adevtool" remote="anaos" />
  <project path="vendor/anaos-state" name="grapheneos_vendor_state" remote="anaos" />

  <!-- Critical platform forks (from GrapheneOS) — TASK_011 -->
  <project path="bionic" name="platform_bionic" remote="anaos" />
  <project path="frameworks/base" name="platform_frameworks_base" remote="anaos" />
  <project path="frameworks/native" name="platform_frameworks_native" remote="anaos" />
  <project path="system/core" name="platform_system_core" remote="anaos" />
  <project path="system/sepolicy" name="platform_system_sepolicy" remote="anaos" />
  <project path="art" name="platform_art" remote="anaos" />
  <project path="libcore" name="platform_libcore" remote="anaos" />
  <project path="build/make" name="platform_build" remote="anaos" />
  <project path="build/soong" name="platform_build_soong" remote="anaos" />
  <project path="system/vold" name="platform_system_vold" remote="anaos" />
  <project path="system/netd" name="platform_system_netd" remote="anaos" />
  <project path="bootable/recovery" name="platform_bootable_recovery" remote="anaos" />

  <!-- Apps / browser (GrapheneOS forks + AnaOS stubs) — TASK_012 / TASK_013 -->
  <project path="external/vanadium" name="Vanadium" remote="anaos" />
  <project path="packages/apps/Camera" name="Camera" remote="anaos" />
  <project path="packages/apps/Updater" name="platform_packages_apps_Updater" remote="anaos" />
  <project path="packages/apps/Auditor" name="Auditor" remote="anaos" />
  <project path="packages/apps/AppStore" name="AppStore" remote="anaos" />
  <project path="packages/apps/SetupWizard" name="platform_packages_apps_SetupWizard" remote="anaos" />
  <project path="packages/apps/PdfViewer" name="PdfViewer" remote="anaos" />

  <!--
    TODO when build host is ready:
    - Pin GrapheneOS/AOSP release tag
    - <include name="full-aosp.xml" /> for remaining projects
    - Replace stub Updater/SetupWizard with branded AnaOS trees
  -->
</manifest>
